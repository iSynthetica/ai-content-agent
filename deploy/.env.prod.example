# Продакшн-змінні. Скопіювати в deploy/.env.prod (він у .gitignore) і заповнити.
# Згенерувати сильні секрети: openssl rand -base64 32

# Домен (без https://). Cloudflare має проксувати його на IP сервера.
DOMAIN=example.com

# Секрет сесій Better Auth. МУСИТЬ бути однаковий для api і web. Мінімум 32 символи.
AUTH_SECRET=

# Паролі БД. owner - суперкористувач (створюється при ініті контейнера).
# app/sweeper - у міграції створюються з паролями 'app'/'sweeper'; рунбук ротує їх на ці значення.
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_SWEEPER_PASSWORD=

# Пароль Redis (у локальному compose його не було - у продакшні обов'язковий).
REDIS_PASSWORD=

# LLM. Без OPENAI_API_KEY worker не стартує (ADR-0014). Для демо без ключа: FAKE_MODELS=1.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TAVILY_API_KEY=          # web-search: без нього FR-2.1 не виконується (див. .env.example)
# FAKE_MODELS=1            # лише для демо без реальних ключів
