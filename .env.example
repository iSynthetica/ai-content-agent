# Postgres — три ролі для RLS (app = підвладна RLS, owner = міграції, sweeper = reconciliation)
DATABASE_URL=postgres://forteq_app:app@localhost:5433/forteq
DATABASE_MIGRATE_URL=postgres://forteq_owner:owner@localhost:5433/forteq
DATABASE_SWEEPER_URL=postgres://forteq_sweeper:sweeper@localhost:5433/forteq

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Object storage (MinIO / S3-сумісне)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=forteq-media

# LLM
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# Observability
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-content-agent

# api / web
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
AUTH_SECRET=change-me-in-prod
