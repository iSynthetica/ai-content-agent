# Postgres — три ролі для RLS (app = підвладна RLS, owner = міграції, sweeper = reconciliation)
DATABASE_URL=postgres://forteq_app:app@localhost:5433/forteq
DATABASE_MIGRATE_URL=postgres://forteq_owner:owner@localhost:5433/forteq
DATABASE_SWEEPER_URL=postgres://forteq_sweeper:sweeper@localhost:5433/forteq

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Object storage (MinIO / S3-сумісне)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=forteq-media

# LLM
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# Observability
# Трейсинг LangSmith (NFR-6.1) — проводка готова, ВИМКНЕНО за замовчуванням.
# Вмикається самими змінними, змін у коді не потребує: метадані прогону (runId/accountId/companyId)
# і теги пайплайн уже проставляє, тож трейси одразу групуються за акаунтом і прогоном.
#
# Якщо після ввімкнення в логах воркера з'являється
#   "Failed to send multipart request. Received status [403]: Forbidden"
# — це відхилення на боці LangSmith, а не баг у коді. Три причини за спаданням імовірності:
#   1. ключ скопійовано не повністю (він показується один раз);
#   2. Service key прив'язаний до іншого workspace — спробуйте Personal Access Token;
#   3. акаунт у європейському регіоні — тоді потрібен LANGSMITH_ENDPOINT нижче.
# Перевірити ключ: curl -H "x-api-key: $LANGSMITH_API_KEY" https://api.smith.langchain.com/sessions?limit=1
# УВАГА: /info віддає 200 навіть без ключа — перевіряти ним валідність не можна.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=ai-content-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # лише для EU-акаунтів

# api / web
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
AUTH_SECRET=change-me-in-prod
